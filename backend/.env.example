# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the two API keys.
#
#     cp .env.example .env
#
# `.env` is gitignored. Never commit it, and never paste a real key into a
# chat, an issue, or a screenshot — a key in a public place is a key you have
# published, and unlike a password nobody thinks to rotate it.
# ---------------------------------------------------------------------------

# The reasoning model. Free tier is enough to run everything here.
# Get one at: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# The intent classifier (stage 2 of routing) and Whisper speech-to-text.
# Free tier: 30 req/min. Get one at: https://console.groq.com
#
# OPTIONAL. Without it, routing falls back to regex + the autonomous agent,
# and voice input is unavailable. Slower and dearer, never broken.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Port the Express server listens on.
PORT=5000

# ---------------------------------------------------------------------------
# Data services. Start them with:
#
#   docker run -d --name helpdesk-mongo  -p 27017:27017 mongo:8
#   docker run -d --name helpdesk-chroma -p 8000:8000   chromadb/chroma
#   docker run -d --name helpdesk-redis  -p 6379:6379   redis:7-alpine
#
# Each one degrades rather than crashes if it is unreachable:
#   no Mongo  -> the server runs without persistence
#   no Chroma -> policy questions say "I cannot look that up" instead of guessing
#   no Redis  -> rate limiting is disabled, everything else works
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/helpdesk
CHROMA_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379
